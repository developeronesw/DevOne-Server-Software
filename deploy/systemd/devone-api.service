[Unit]
Description=DevOne Server API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=devone
Group=devone
WorkingDirectory=/opt/devone/current/apps/api
EnvironmentFile=-/etc/devone/devone.env
ExecStart=/usr/bin/node /opt/devone/current/apps/api/dist/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devone /var/log/devone
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
