server {
    listen 80;
    listen [::]:80;
    server_name __DEVONE_PANEL_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/devone-acme;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DEVONE_PANEL_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DEVONE_PANEL_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DEVONE_PANEL_DOMAIN__/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    root /opt/devone/current/apps/dashboard/dist;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }
}
