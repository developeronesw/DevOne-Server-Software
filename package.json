{
  "name": "devone-server-software",
  "version": "1.0.0-alpha.3",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "pnpm -r check",
    "build": "pnpm -r build",
    "test": "pnpm build && node --test tests/*.test.mjs && python3 scripts/verify-distribution.py",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @devone/dashboard dev",
    "qa": "node scripts/qa-runner.mjs",
    "qa:release": "node scripts/qa-runner.mjs --release"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
